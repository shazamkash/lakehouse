# Lakehouse Configuration Template
# Copy this file to .env and update with your settings

# ==============================================================================
# Remote Server Configuration
# ==============================================================================
# Set this to your remote server IP or hostname
# For local development, use 'localhost'
# For remote server (e.g., 10.16.36.36), set the IP address
LAKEHOUSE_HOST=10.16.36.36

# ==============================================================================
# MinIO Configuration
# ==============================================================================
# MinIO endpoint (external access from Python client)
# If LAKEHOUSE_HOST is set, this defaults to http://${LAKEHOUSE_HOST}:9000
# LAKEHOUSE_MINIO_ENDPOINT=http://10.16.36.36:9000

# MinIO credentials
LAKEHOUSE_MINIO_ACCESS_KEY=minioadmin
LAKEHOUSE_MINIO_SECRET_KEY=minioadmin

# MinIO internal endpoint (for Spark access within Docker network)
# Usually no need to change this - Spark uses internal Docker network names
LAKEHOUSE_MINIO_INTERNAL_ENDPOINT=http://minio:9000

# ==============================================================================
# Spark Configuration
# ==============================================================================
# Spark Master URL (external access from Python client)
# If LAKEHOUSE_HOST is set, this defaults to spark://${LAKEHOUSE_HOST}:7077
# LAKEHOUSE_SPARK_MASTER=spark://10.16.36.36:7077

# ==============================================================================
# Trino Configuration
# ==============================================================================
# Trino host (external access from Python client)
# If LAKEHOUSE_HOST is set, this defaults to ${LAKEHOUSE_HOST}
# LAKEHOUSE_TRINO_HOST=10.16.36.36

# Trino port
LAKEHOUSE_TRINO_PORT=8082

# Trino username
LAKEHOUSE_TRINO_USER=admin

# ==============================================================================
# Unity Catalog Configuration
# ==============================================================================
# Unity Catalog URL (external access from Python client)
# If LAKEHOUSE_HOST is set, this defaults to http://${LAKEHOUSE_HOST}:8081
# LAKEHOUSE_UNITY_CATALOG_URL=http://10.16.36.36:8081

# ==============================================================================
# Usage Instructions
# ==============================================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Update LAKEHOUSE_HOST with your server IP
#
# 3. Load environment variables (choose one):
#
#    a) Using source (bash/zsh):
#       export $(cat .env | xargs)
#
#    b) Using python-dotenv (recommended):
#       pip install python-dotenv
#       # Add to your Python script:
#       from dotenv import load_dotenv
#       load_dotenv()
#
#    c) Using direnv (automatic):
#       # Install direnv, then:
#       echo "dotenv" > .envrc
#       direnv allow
#
# 4. Initialize the client (will automatically use environment variables):
#    from lakehouse_client import LakehouseClient
#    client = LakehouseClient()
#
# ==============================================================================
